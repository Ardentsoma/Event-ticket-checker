# Port the Express server listens on. Most platforms (Render, Railway, Fly)
# inject this automatically — leave unset to default to 3000.
PORT=3000

# The Abuja Events upstream REST API. Override only if the upstream URL changes.
UPSTREAM_API_BASE=https://events-api-a9et.onrender.com/api/v1

# Set to "production" when running the compiled build (npm start).
# NODE_ENV=production